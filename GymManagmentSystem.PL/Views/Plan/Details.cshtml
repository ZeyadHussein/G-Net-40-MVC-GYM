@model Plan

<div class="container">
    <main role="main" class="pb-3">

        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-md-6">

                    <div class="card shadow-lg border-0">

                        <div class="card-header text-white text-center py-5 @(Model.IsActive ? "bg-primary-color" : "bg-secondary")">
                            <i class="bi bi-star display-4"></i>
                            <h3 class="mt-2 mb-0">@Model.Name</h3>
                        </div>

                        <div class="card-body p-4">

                            <div class="text-center mb-4">
                                <div class="display-4 fw-bold text-primary-color">
                                    @Model.Price
                                </div>
                                <small class="text-muted">EGP</small>
                            </div>

                            <hr />

                            <p class="mb-2">
                                <i class="bi bi-calendar-check text-primary-color me-2"></i>
                                <strong>Duration:</strong> @Model.DurationInDays days
                            </p>

                            <p class="mb-2">
                                <i class="bi bi-info-circle text-primary-color me-2"></i>
                                <strong>Description:</strong>
                            </p>

                            <p class="text-muted">@Model.Description</p>

                            <p class="mt-3">
                                <strong>Status:</strong>

                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </p>

                            <div class="d-grid mt-4">
                                <a asp-controller="Plan"
                                   asp-action="Index"
                                   class="btn btn-outline-primary">
                                    Back to Plans
                                </a>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </div>

    </main>
</div>
