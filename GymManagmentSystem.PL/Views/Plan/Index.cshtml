@using GymManagmentSystem.DAL.Models
@model IEnumerable<Plan>

<div class="container">
    <main role="main" class="pb-3">

        <header class="d-flex justify-content-between mt-5 mb-4 align-items-center">
            <div>
                <h2 class="text-primary-color mb-0">Membership Plans</h2>
                <p class="text-muted">
                    Manage your gym membership packages
                </p>
            </div>
        </header>

        @if (TempData["SuccessMessage"] is not null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        @if (TempData["ErrorMessage"] is not null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["ErrorMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="row g-4">

                @foreach (var plan in Model)
                {
                    <div class="col-12 col-md-6 col-lg-4">

                        <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">

                            <div class="card-header text-white text-center py-4
                                         @(plan.IsActive ? "bg-primary" : "bg-secondary")">

                                <h4 class="mb-0 fw-bold">
                                    @plan.Name
                                </h4>

                            </div>

                            <div class="card-body d-flex flex-column">

                                <div class="text-center mb-4">

                                    <h1 class="fw-bold text-primary">
                                        @plan.Price EGP
                                    </h1>

                                    <span class="badge
                                                  @(plan.IsActive
                                                                                    ? "bg-success"
                                                                                    : "bg-secondary")">

                                        @(plan.IsActive
                                                                        ? "Active"
                                                                        : "Inactive")

                                    </span>

                                </div>

                                <div class="mb-4">

                                    <p class="mb-2">
                                        <i class="bi bi-calendar-event me-2 text-primary"></i>

                                        <strong>Duration:</strong>

                                        @plan.DurationInDays Days
                                    </p>

                                    <p class="mb-0">
                                        <i class="bi bi-card-text me-2 text-primary"></i>

                                        <strong>Description:</strong>
                                    </p>

                                    <p class="text-muted mt-2">
                                        @plan.Description
                                    </p>

                                </div>

                                <div class="mt-auto">

                                    <div class="d-grid gap-2">

                                        <a asp-controller="Plan"
                                           asp-action="Details"
                                           asp-route-id="@plan.Id"
                                           class="btn btn-outline-primary">

                                            <i class="bi bi-eye me-1"></i>

                                            View Details
                                        </a>

                                        <a asp-controller="Plan"
                                           asp-action="Edit"
                                           asp-route-id="@plan.Id"
                                           class="btn btn-outline-dark">

                                            <i class="bi bi-pencil-square me-1"></i>

                                            Edit
                                        </a>

                                        <form asp-controller="Plan"
                                              asp-action="Activate"
                                              asp-route-id="@plan.Id"
                                              method="post">

                                            <button type="submit"
                                                    class="btn w-100
                                                            @(plan.IsActive
                                                                                                        ? "btn-outline-danger"
                                                                                                        : "btn-outline-success")">

                                        @if (plan.IsActive)
                                                {
                                                    <span>
                                                        <i class="bi bi-x-circle me-1"></i>
                                                        Deactivate
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>
                                                        <i class="bi bi-check-circle me-1"></i>
                                                        Activate
                                                    </span>
                                                }

                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-inbox display-1 text-muted"></i>

                <h4 class="mt-3 text-muted">
                    No Plans Available
                </h4>

            </div>
        }

    </main>
</div>